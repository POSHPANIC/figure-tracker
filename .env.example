# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real keys.

# --- Database -------------------------------------------------------------
# Local development: run `npm run db:dev` and paste the URLs it prints here.
# Production: use the connection string from Neon / Vercel Postgres / Supabase.
DATABASE_URL=""
SHADOW_DATABASE_URL=""

# --- eBay Browse API ------------------------------------------------------
# https://developer.ebay.com -> Application Keysets -> Production
# Free, instant. Leave blank and eBay ingestion skips itself instead of failing.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_ENV="PRODUCTION"

# --- AmiAmi ---------------------------------------------------------------
# Off by default. Read docs/DATA_SOURCES.md before turning this on.
AMIAMI_ENABLED="false"

# --- Cron ------------------------------------------------------------------
# Long random string. Required by /api/cron/* so only your scheduler can
# trigger ingestion. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
