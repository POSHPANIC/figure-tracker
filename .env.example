# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real keys.

# --- Database -------------------------------------------------------------
# Local development: run `npm run db:dev` and paste the URLs it prints here.
# Production: use the connection string from Neon / Vercel Postgres / Supabase.
# Neon gives you two connection strings. The app wants the pooled one; Prisma
# Migrate wants the direct one, because migrations take a session-level
# advisory lock and a pooler cannot hold a session (P1002, "timed out trying to
# acquire a postgres advisory lock").
#
# It is the WHOLE connection string, not just the host — copy DATABASE_URL and
# delete "-pooler" from the hostname, leaving everything else alone:
#   pooled  postgresql://user:pass@ep-something-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
#   direct  postgresql://user:pass@ep-something.us-west-2.aws.neon.tech/neondb?sslmode=require
#
# Locally, leave DIRECT_DATABASE_URL unset — there is no pooler in front of
# `prisma dev`, and it falls back to DATABASE_URL.
DIRECT_DATABASE_URL=

DATABASE_URL=""
SHADOW_DATABASE_URL=""

# --- eBay Browse API ------------------------------------------------------
# https://developer.ebay.com -> Application Keysets -> Production
# Free, instant. Leave blank and eBay ingestion skips itself instead of failing.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_ENV="PRODUCTION"

# --- eBay account deletion notifications ---
# eBay disables production keysets until you register a deletion-notification
# endpoint (or are granted an exemption). See docs/SETUP.md.
#
# Any string you like, 32-80 characters, letters/numbers/underscore/hyphen only.
# It must match what you paste into the eBay developer portal. Generate one:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
EBAY_VERIFICATION_TOKEN=""
# The exact URL registered with eBay, e.g.
#   https://your-site.vercel.app/api/ebay/account-deletion
# It's hashed as part of validation, so it must match character for character.
EBAY_DELETION_ENDPOINT=""

# --- AmiAmi ---------------------------------------------------------------
# Off by default. Read docs/DATA_SOURCES.md before turning this on.
AMIAMI_ENABLED="false"

# --- Authentication --------------------------------------------------------
# Signs session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT value in production than in development.
AUTH_SECRET=""

# The canonical public URL, e.g. "https://figureindex.com".
#
# Leave BLANK in development — Auth.js then infers localhost from the request,
# which is what you want.
#
# SET IT IN PRODUCTION. Without it, Auth.js builds OAuth callbacks from whatever
# host the visitor arrived on, and Vercel gives every deployment its own URL
# (figure-tracker-abc123-you.vercel.app). Sign in from one of those and the
# provider sees a redirect_uri it has never heard of:
#   "Invalid OAuth2 redirect_uri"
# You cannot register those URLs in advance; they're generated per push.
#
# This must match the redirect URI registered with each OAuth provider.
AUTH_URL=""

# OAuth apps — optional. A provider with no credentials just doesn't show up
# on the sign-in page. In development there's always a local login box.
# Google:  https://console.cloud.google.com/apis/credentials
# Discord: https://discord.com/developers/applications
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# --- Email sign-in links ---------------------------------------------------
# https://resend.com — create an API key and verify a sending domain.
# Leave the key blank in development: links are printed to the terminal rather
# than sent, so the whole flow works with no email account.
# In production both are required, or email sign-in is hidden.
AUTH_RESEND_KEY=""
# Must be on a domain verified in Resend, e.g. "FigureIndex <hello@figureindex.com>"
EMAIL_FROM=""

# --- Cron ------------------------------------------------------------------
# Long random string. Required by /api/cron/* so only your scheduler can
# trigger ingestion. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# --- Danbooru (optional) ---------------------------------------------------
# Only used by "npm run derive:characters", and only for figures AniList can't
# identify — game characters and VTubers, mostly. Tag names only: a character
# and the work they belong to. No images, nothing shown to visitors.
#
# Leave these unset and that step is simply skipped.
# Get a key at https://danbooru.donmai.us/profile after making an account.
DANBOORU_LOGIN=
DANBOORU_API_KEY=
# The number from your profile URL (/users/1234567). Their docs ask that the
# User-Agent carry it. Optional — without it we send your username instead.
DANBOORU_USER_ID=

# --- Affiliate tagging (all optional) ---------------------------------------
# Every one of these is inert when unset: the link still renders and still
# works, it just goes out untagged. There is no half-configured state.
#
# Solaris Japan. Their programme runs on Affiliatly; this is the `aff` value.
SOLARIS_AFFILIATE_ID=

# --- Proxy-buying links (Buyee / ZenMarket) ---------------------------------
# Search links to the Japanese secondhand market, shown only on figures that no
# shop sells any more. See docs/PROXY_PARTNERSHIPS.md.
#
# Off by default because the URL formats in lib/proxy-links.ts are UNVERIFIED —
# every automated request to both hosts was refused, so they were assembled from
# documentation rather than observed. Click them once before setting this.
PROXY_LINKS_ENABLED=
ZENMARKET_AFFILIATE_ID=
BUYEE_AFFILIATE_ID=
