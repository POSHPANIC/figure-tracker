# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated Prisma client — rebuilt by `prisma generate` on install
/lib/generated

# AI-assistant reference docs installed by `prisma init`. Regenerated on demand
# and specific to whichever editor you use, so not worth tracking.
/.claude/skills/
/.windsurf/
/.agents/
skills-lock.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Cached pages from the Good Smile archive import (scripts/import-gsc.ts)
.gsc-cache/
