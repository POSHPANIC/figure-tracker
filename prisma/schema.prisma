// Figure Tracker — database schema
// Docs: https://pris.ly/d/prisma-schema
//
// Mental model:
//   Figure         = one physical product (e.g. "Nendoroid 1234 Marin Kitagawa")
//   Listing        = a live for-sale item on some marketplace, points at a Figure
//   Sale           = a completed transaction, points at a Figure
//   PriceSnapshot  = one row per figure/condition/day, pre-aggregated so charts are fast
//
// Money rule: every price is stored twice — the original `amount` + `currency`
// as advertised, and `amountUsd` normalized at ingest time. Charts read amountUsd
// so we never mix yen and dollars on the same axis.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum FigureCategory {
  SCALE // 1/7, 1/8, 1/4 etc. static scale figures
  NENDOROID
  FIGMA
  PRIZE // arcade / crane game prizes
  TRADING // blind box, gashapon
  GARAGE_KIT
  MODEL_KIT // Gunpla, Figure-rise
  PLUSH
  OTHER
}

enum ReleaseStatus {
  ANNOUNCED
  PREORDER
  RELEASED
  DELAYED
  CANCELLED
}

model Manufacturer {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  websiteUrl String?
  createdAt DateTime @default(now())

  figures Figure[]

  @@index([slug])
}

/// The franchise a figure comes from, e.g. "Fate/Grand Order", "Oshi no Ko".
model Series {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  figures    Figure[]
  characters Character[]

  @@index([slug])
}

model Character {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  seriesId String?
  series   Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  figures Figure[] @relation("FigureCharacters")

  @@unique([name, seriesId])
  @@index([slug])
}

model Figure {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  /// Original Japanese name, when we have it — helps match AmiAmi/Mandarake listings.
  nameJa      String?
  description String?
  category    FigureCategory @default(OTHER)
  status      ReleaseStatus  @default(RELEASED)

  /// e.g. "1/7". Null for non-scale products.
  scale       String?
  /// Height in millimetres.
  heightMm    Int?
  releaseDate DateTime?

  /// Manufacturer's suggested retail price, as originally announced.
  msrpAmount   Decimal? @db.Decimal(12, 2)
  msrpCurrency String?  @db.VarChar(3)

  primaryImageUrl String?

  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  seriesId       String?
  series         Series?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  characters     Character[]   @relation("FigureCharacters")

  images      FigureImage[]
  identifiers FigureIdentifier[]
  listings    Listing[]
  sales       Sale[]
  snapshots   PriceSnapshot[]

  // --- Denormalized fields, recomputed nightly by the aggregation job. ---
  // Kept on the row so list/search pages need only one query.
  /// Median USD sale price over the trailing 90 days, NEW condition.
  marketValueUsd    Decimal? @db.Decimal(12, 2)
  /// Percent change in marketValueUsd vs. 30 days ago. 12.5 means +12.5%.
  change30dPct      Decimal? @db.Decimal(8, 2)
  /// Number of recorded sales in the trailing 90 days — our confidence signal.
  salesVolume90d    Int      @default(0)
  lastAggregatedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collectionItems CollectionItem[]
  wishlistItems   WishlistItem[]
  priceAlerts     PriceAlert[]

  @@index([slug])
  @@index([manufacturerId])
  @@index([seriesId])
  @@index([category])
  @@index([marketValueUsd])
  @@index([releaseDate])
}

model FigureImage {
  id       String @id @default(cuid())
  figureId String
  figure   Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)
  url      String
  sortOrder Int   @default(0)

  @@index([figureId])
}

/// External IDs we can match marketplace listings against.
/// `kind` is e.g. "MFC", "AMIAMI_CODE", "JAN", "GSC_PRODUCT", "EBAY_EPID".
model FigureIdentifier {
  id       String @id @default(cuid())
  figureId String
  figure   Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)
  kind     String
  value    String

  @@unique([kind, value])
  @@index([figureId])
}

// ---------------------------------------------------------------------------
// Marketplace data
// ---------------------------------------------------------------------------

enum ItemCondition {
  NEW_SEALED
  NEW_OPENED
  USED_COMPLETE
  USED_INCOMPLETE
  DAMAGED
  UNKNOWN
}

/// A marketplace or retailer we pull prices from.
model Source {
  id       String  @id @default(cuid())
  /// Stable machine key: "ebay", "amiami", "hlj", "mandarake".
  key      String  @unique
  name     String
  homepage String?
  /// Whether the ingestion job should currently run for this source.
  enabled  Boolean @default(true)

  listings Listing[]
  sales    Sale[]
  runs     IngestRun[]
}

/// An item currently (or recently) offered for sale.
model Listing {
  id       String @id @default(cuid())
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  figureId String?
  figure   Figure? @relation(fields: [figureId], references: [id], onDelete: SetNull)

  /// The source's own ID for this listing — used to upsert instead of duplicating.
  externalId String
  title      String
  url        String
  imageUrl   String?
  condition  ItemCondition @default(UNKNOWN)

  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @db.VarChar(3)
  /// `amount` converted to USD using fxRate at the time we saw it.
  amountUsd  Decimal  @db.Decimal(12, 2)
  fxRate     Decimal  @db.Decimal(18, 8)
  shippingUsd Decimal? @db.Decimal(12, 2)

  isActive  Boolean   @default(true)
  firstSeen DateTime  @default(now())
  lastSeen  DateTime  @default(now())

  /// Confidence that this listing really is the linked figure, 0..1.
  /// Anything below MATCH_REVIEW_THRESHOLD is excluded from price aggregation.
  matchScore Float?

  @@unique([sourceId, externalId])
  @@index([figureId, isActive])
  @@index([lastSeen])
}

/// Whether a sale counts toward market value.
///
/// API-sourced sales are APPROVED on arrival. User-reported ones are screened
/// (see lib/sales/validate.ts) and only held for review when they look wrong —
/// holding everything would make reporting useless, auto-approving everything
/// would let one person move a figure's published value.
enum SaleStatus {
  APPROVED
  PENDING_REVIEW
  REJECTED
}

/// A completed transaction. This is what actually drives market value.
model Sale {
  id       String  @id @default(cuid())
  sourceId String
  source   Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  figureId String
  figure   Figure  @relation(fields: [figureId], references: [id], onDelete: Cascade)

  externalId String?
  title      String?
  url        String?
  condition  ItemCondition @default(UNKNOWN)

  amount    Decimal @db.Decimal(12, 2)
  currency  String  @db.VarChar(3)
  amountUsd Decimal @db.Decimal(12, 2)
  fxRate    Decimal @db.Decimal(18, 8)

  soldAt DateTime

  /// True when a signed-in user reported this sale rather than an API.
  isUserReported Boolean @default(false)
  reportedById   String?
  reportedBy     User?   @relation("SalesReported", fields: [reportedById], references: [id], onDelete: SetNull)

  status       SaleStatus @default(APPROVED)
  /// Why the screening held this one back, shown to the reporter and moderator.
  flagReason   String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?      @relation("SalesReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?

  createdAt DateTime @default(now())

  @@unique([sourceId, externalId])
  @@index([figureId, soldAt])
  @@index([soldAt])
  // Aggregation reads by (figure, status, condition, date) — this covers it.
  @@index([figureId, status, condition, soldAt])
  // The moderation queue reads pending items oldest-first.
  @@index([status, createdAt])
  @@index([reportedById, createdAt])
}

/// One pre-aggregated row per figure/condition/day. The price chart reads only
/// this table, so it stays fast no matter how many raw sales we accumulate.
model PriceSnapshot {
  id        String        @id @default(cuid())
  figureId  String
  figure    Figure        @relation(fields: [figureId], references: [id], onDelete: Cascade)
  condition ItemCondition
  /// Midnight UTC of the day being summarized.
  date      DateTime      @db.Date

  minUsd    Decimal @db.Decimal(12, 2)
  medianUsd Decimal @db.Decimal(12, 2)
  avgUsd    Decimal @db.Decimal(12, 2)
  maxUsd    Decimal @db.Decimal(12, 2)
  /// How many sales went into this row. 1-2 means treat the point with suspicion.
  sampleSize Int

  /// Lowest active asking price we saw that day, for the "buy it now" line.
  lowestAskUsd Decimal? @db.Decimal(12, 2)

  @@unique([figureId, condition, date])
  @@index([figureId, date])
}

/// Audit log for ingestion jobs, so failures are visible instead of silent.
model IngestRun {
  id        String    @id @default(cuid())
  sourceId  String
  source    Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  finishedAt DateTime?
  /// "running" | "success" | "error"
  status    String    @default("running")
  itemsSeen Int       @default(0)
  itemsUpserted Int   @default(0)
  error     String?

  @@index([sourceId, startedAt])
}

/// Daily USD conversion rates, so historical prices stay reproducible.
model FxRate {
  id       String   @id @default(cuid())
  currency String   @db.VarChar(3)
  date     DateTime @db.Date
  /// Multiply an amount in `currency` by this to get USD.
  rateToUsd Decimal @db.Decimal(18, 8)

  @@unique([currency, date])
}

// ---------------------------------------------------------------------------
// Users — schema is in place now so adding auth later needs no migration.
// Model shapes follow the Auth.js (NextAuth) Prisma adapter conventions.
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// Public profile handle, e.g. figuretracker.app/u/ethan
  username      String?   @unique
  bio           String?
  role          UserRole  @default(USER)
  /// When false the user's collection is only visible to themselves.
  publicProfile Boolean   @default(false)
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  collectionItems CollectionItem[]
  wishlistItems   WishlistItem[]
  priceAlerts     PriceAlert[]
  reportedSales   Sale[]           @relation("SalesReported")
  reviewedSales   Sale[]           @relation("SalesReviewed")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CollectionItem {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  figureId String
  figure   Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  quantity  Int           @default(1)
  condition ItemCondition @default(NEW_SEALED)
  /// What the user actually paid, for profit/loss against market value.
  paidAmount   Decimal? @db.Decimal(12, 2)
  paidCurrency String?  @db.VarChar(3)
  /// `paidAmount` converted at the rate on the day it was entered. Stored so
  /// portfolio totals can sum a mixed-currency collection without re-converting
  /// (and silently re-valuing) every past purchase on each page load.
  paidAmountUsd Decimal? @db.Decimal(12, 2)
  purchasedAt  DateTime?
  notes        String?

  createdAt DateTime @default(now())

  @@unique([userId, figureId, condition])
  @@index([userId])
}

model WishlistItem {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  figureId String
  figure   Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)
  /// 1 = someday, 5 = grail.
  priority Int    @default(3)

  createdAt DateTime @default(now())

  @@unique([userId, figureId])
  @@index([userId])
}

model PriceAlert {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  figureId String
  figure   Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  /// Fire when a listing's USD price drops to or below this.
  targetUsd Decimal       @db.Decimal(12, 2)
  condition ItemCondition @default(NEW_SEALED)
  active    Boolean       @default(true)
  lastFired DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, figureId, condition])
  @@index([active])
}
