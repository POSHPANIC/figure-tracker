// Figure Tracker — database schema
// Docs: https://pris.ly/d/prisma-schema
//
// Mental model:
//   Figure         = one physical product (e.g. "Nendoroid 1234 Marin Kitagawa")
//   Listing        = a live for-sale item on some marketplace, points at a Figure
//   Sale           = a completed transaction, points at a Figure
//   PriceSnapshot  = one row per figure/condition/day, pre-aggregated so charts are fast
//
// Money rule: every price is stored twice — the original `amount` + `currency`
// as advertised, and `amountUsd` normalized at ingest time. Charts read amountUsd
// so we never mix yen and dollars on the same axis.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum FigureCategory {
  SCALE // 1/7, 1/8, 1/4 etc. static scale figures
  NENDOROID
  FIGMA
  HELLO_GOOD_SMILE // "HELLO! GOOD SMILE" — small deformed prepainted figures
  PRIZE // arcade / crane game prizes
  TRADING // blind box, gashapon
  GARAGE_KIT
  MODEL_KIT // Gunpla, Figure-rise
  PLUSH
  OTHER
}

enum ReleaseStatus {
  ANNOUNCED
  PREORDER
  RELEASED
  DELAYED
  CANCELLED
}

model Manufacturer {
  id         String   @id @default(cuid())
  name       String   @unique
  slug       String   @unique
  websiteUrl String?
  createdAt  DateTime @default(now())

  figures Figure[]

  @@index([slug])
}

/// A body of work that shares an origin — Evangelion, Fate, THE IDOLM@STER.
///
/// Series are what a manufacturer prints on a box, and they are finer than what
/// anyone browses by: "Evangelion: 3.0+1.0 Thrice Upon a Time" holds two
/// figures, "EVANGELION RACING" another two, and someone looking for an Asuka
/// wants all of them at once. This is the level above.
///
/// Assignment is curated, never inferred. A first word in common is not a
/// franchise: the catalogue contains Demon Slayer and Demon's Souls, Love Live!
/// and To Love-Ru, The Legend of Zelda and The Legend of Hei. Grouping those
/// automatically would repeat the wrong-match problem the listing matcher exists
/// to avoid, on the axis people navigate by.
model Franchise {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  series Series[]

  @@index([slug])
}

/// The franchise a figure comes from, e.g. "Fate/Grand Order", "Oshi no Ko".
model Series {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  /// Null until someone assigns it. A series with no franchise still browses
  /// and filters normally — it just doesn't group with anything.
  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)

  /// Japanese title, e.g. その着せ替え人形は恋をする.
  titleJa   String?
  /// Alternate titles AniList knows. Sellers use these interchangeably — the
  /// romaji "Sono Bisque Doll" turns up in listings far more than you'd expect.
  synonyms  String[]
  anilistId Int?

  figures    Figure[]
  characters Character[]

  @@index([slug])
}

model Character {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  seriesId String?
  series   Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  /// Japanese name, e.g. 喜多川海夢. Sourced from AniList.
  /// Used by the matcher: Japanese text in a listing title is a strong, safe
  /// signal because it can't collide with English words by accident.
  nameJa String?

  /// Nicknames and alternate spellings — "Marine", "Thorn Princess", "Powy".
  /// Stored for search and display. Deliberately NOT used to gate matching:
  /// AniList lists epithets like "Number One" and "Chihuahua Girl", and a gate
  /// that accepts "one" or "girl" would undo the precision work in match.ts.
  aliases String[]

  /// AniList's ID, so re-syncing doesn't depend on names staying stable.
  anilistId Int?

  figures Figure[] @relation("FigureCharacters")

  @@unique([name, seriesId])
  @@index([slug])
}

model Figure {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  /// The Japanese product name, as the box has it: "ねんどろいど エンデヴァー".
  /// This is what a Japanese seller titles a listing with, so it is what any
  /// search against the secondhand market has to be built from.
  nameJa      String?
  /// The entry this one was folded into, when two archive records describe the
  /// same product.
  ///
  /// Good Smile publishes a reissue as its own archive entry, so the catalogue
  /// holds two rows for one figure — same name, maker, scale and sculpt, a
  /// later date and sometimes a different price. A seller's title cannot tell
  /// them apart, so the matcher scored both identically, called it a tie and
  /// refused to answer: every listing for those products went unmatched.
  ///
  /// Superseded rather than deleted. Both entries are real records of real
  /// releases, their pages stay reachable by redirect, and a merge decided by
  /// a heuristic should be reversible by setting one column back to null.
  supersededById String?
  supersededBy   Figure?  @relation("Reissues", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     Figure[] @relation("Reissues")

  /// The kana reading of that name — "ねんどろいど えんで㔲ぁー".
  ///
  /// A pronunciation guide, not a title: nobody writes a listing this way, so
  /// it must never be used as a search query. It is kept because it feeds
  /// search — someone typing kana should still find the figure — and because
  /// early archive imports put it in nameJa, where it looked like a name.
  nameJaReading String?
  description String?
  category    FigureCategory @default(OTHER)
  status      ReleaseStatus  @default(RELEASED)

  /// e.g. "1/7". Null for non-scale products.
  scale       String?
  /// Height in millimetres.
  heightMm    Int?
  releaseDate DateTime?

  /// Whether releaseDate is known to the day or only to the month.
  ///
  /// The Good Smile archive and the Kotobukiya store both state a month and no
  /// day, so those dates carry a placeholder day of 15 and mean "some time that
  /// month". Solaris state a full date. The distinction is not cosmetic: it
  /// decides whether MSRP converts at that day's rate or at the month's
  /// average, and quoting a day's rate against a date we guessed would be
  /// inventing precision. See lib/ingest/fx-monthly.ts.
  releaseDatePrecision String @default("MONTH") @db.VarChar(5)

  /// Whether this figure may want a content warning.
  ///
  /// Hidden: nothing renders it and nothing filters on it yet. It exists so a
  /// filter can be built on data already gathered rather than on a scramble
  /// afterwards.
  ///
  /// `nsfwSource` records *why*, because the confidence differs enormously by
  /// where it came from. "solaris" is a retailer's own classification of their
  /// own product. A "keyword:" source is our inference from a name, which is
  /// weaker and should be reviewable as such — without the source recorded,
  /// the two are indistinguishable and the weak ones can never be revisited.
  nsfw       Boolean @default(false)
  nsfwSource String?

  /// Manufacturer's suggested retail price, as originally announced.
  msrpAmount   Decimal? @db.Decimal(12, 2)
  msrpCurrency String?  @db.VarChar(3)

  primaryImageUrl String?

  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  seriesId       String?
  series         Series?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  characters     Character[]   @relation("FigureCharacters")

  images      FigureImage[]
  identifiers FigureIdentifier[]
  submissions Submission[]
  candidates  FigureCandidate[]
  fieldLocks  FigureFieldLock[]
  listings    Listing[]
  sales       Sale[]
  snapshots   PriceSnapshot[]

  // --- Denormalized fields, recomputed nightly by the aggregation job. ---
  // Kept on the row so list/search pages need only one query.
  /// Median USD sale price over the trailing 90 days, NEW condition.
  marketValueUsd   Decimal?  @db.Decimal(12, 2)

  /// The median of what sellers are currently *asking*, and the number of
  /// listings behind it.
  ///
  /// Not a market value and never to be shown as one. An asking price is what a
  /// seller hopes for, and the ones that sell leave the sample while the ones
  /// that do not stay in it, so a median of what is still for sale is biased
  /// upward by construction — measured at about 2.2x the manufacturer's retail
  /// price across the catalogue.
  ///
  /// It exists because eBay refused Marketplace Insights on 2026-08-19, leaving
  /// no sold-price source at all: marketValueUsd is null on every figure, and a
  /// price guide showing no prices helps nobody. Labelled as an asking price,
  /// with its sample size beside it, this is true and useful.
  askMedianUsd     Decimal?  @db.Decimal(12, 2)
  askListings      Int       @default(0)

  /// The manufacturer's own store page for this product, and what it said.
  ///
  /// Filled in one figure at a time, by hand or from the store-link field on
  /// the correction form. Their store cannot be enumerated — no sitemap, and
  /// the only index is behind a path robots.txt asks bots to leave alone — so
  /// there is no run that fills this in for the catalogue.
  ///
  /// storeAvailable is deliberately nullable rather than defaulting to false.
  /// "We could not tell" and "you cannot buy it" are different answers, and
  /// showing the second when we mean the first costs somebody a purchase.
  storeUrl         String?
  /// Their own listed price, in whatever currency they list it in. Not yen by
  /// assumption: Kotobukiya's US store prices in dollars, and a column called
  /// storePriceJpy holding dollars would be a lie told once and read forever.
  storePriceAmount Decimal? @db.Decimal(12, 2)
  storePriceCurrency String? @db.VarChar(3)
  storeAvailable   Boolean?
  storeClosesAt    DateTime?
  storeCheckedAt   DateTime?
  /// Percent change in marketValueUsd vs. 30 days ago. 12.5 means +12.5%.
  change30dPct     Decimal?  @db.Decimal(8, 2)
  /// Number of recorded sales in the trailing 90 days — our confidence signal.
  salesVolume90d   Int       @default(0)
  lastAggregatedAt DateTime?

  // --- Demand signals, for deciding where to spend the polling budget ------
  //
  // The catalogue is far larger than the marketplace quota. eBay allows a few
  // thousand searches a day against seven thousand figures, so polling every
  // figure equally means every figure's prices are equally stale. These say
  // which ones anybody actually cares about.
  /// Times this figure's page has been opened. Crawlers are not counted.
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  /// When a marketplace was last searched for this figure. Distinct from
  /// lastAggregatedAt, which only moves for figures that have sales — using
  /// that to rotate polling meant figures with no sales never rotated at all.
  lastPolledAt DateTime?

  /// Everything this figure can be found by, in one lowercase blob: its own
  /// names, its manufacturer, its series under every title, and every character
  /// with their Japanese name and nicknames.
  ///
  /// Denormalized for two reasons. Searching the relations directly meant five
  /// OR'd joins on every keystroke; and Prisma cannot do partial matching inside
  /// a Postgres array at all, so character aliases were unreachable — someone
  /// searching "Saber" could not find Altria Pendragon.
  ///
  /// Rebuilt by the nightly job and whenever catalogue metadata changes.
  searchText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collectionItems CollectionItem[]
  wishlistItems   WishlistItem[]
  priceAlerts     PriceAlert[]

  @@index([slug])
  @@index([manufacturerId])
  @@index([seriesId])
  @@index([category])
  @@index([marketValueUsd])
  @@index([releaseDate])
  // Prefix searches use this. A substring match ("%marin%") can't, and wants a
  // pg_trgm GIN index instead — worth adding when the catalogue outgrows a scan.
  @@index([searchText])
  // The polling queue reads by staleness.
  @@index([lastPolledAt])
}

/// A catalog image for a figure — the product photo, not a marketplace listing's.
///
/// These are used under permission granted by the manufacturer, which normally
/// comes with conditions: display a credit, link back, don't alter the image.
/// So provenance is stored alongside the URL rather than assumed. If someone
/// later asks under what terms an image is being used, the answer is a row in
/// this table, not a memory of an email.
model FigureImage {
  id        String @id @default(cuid())
  figureId  String
  figure    Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int    @default(0)

  /// Attribution shown next to the image, e.g. "© Good Smile Company".
  /// Usually a condition of the permission, so it is not optional in practice.
  credit      String?
  /// The press kit or product page the image was supplied on.
  sourceUrl   String?
  /// What was actually agreed, in our own words — who granted it and when.
  licenseNote String?

  addedById String?
  addedBy   User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([figureId, sortOrder])
}

/// External IDs we can match marketplace listings against.
/// `kind` is e.g. "MFC", "AMIAMI_CODE", "JAN", "GSC_PRODUCT", "EBAY_EPID".
/// A figure attribute checked against the manufacturer and confirmed correct,
/// which closes it to further suggestions.
///
/// The catalogue attracts repeat corrections to the same handful of fields,
/// usually where the box and a retailer disagree and the box is right. Without
/// somewhere to record "we looked, this is right", every moderator re-does that
/// check from scratch and the queue fills with the same claim.
///
/// A row per confirmed field rather than a list on the figure: it records who
/// confirmed it and when, which is what you want when someone later insists the
/// value is wrong — and unlocking is a delete rather than a rewrite.
model FigureFieldLock {
  id       String @id @default(cuid())
  figureId String
  figure   Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  /// One of the editable field keys — see lib/figure-fields.ts.
  field String

  /// What was checked, in the moderator's words. "Box states 230mm."
  note String?

  lockedById String?
  lockedBy   User?    @relation("FieldLocks", fields: [lockedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([figureId, field])
  @@index([figureId])
}

model FigureIdentifier {
  id       String @id @default(cuid())
  figureId String
  figure   Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)
  kind     String
  value    String

  @@unique([kind, value])
  @@index([figureId])
}

// ---------------------------------------------------------------------------
// Marketplace data
// ---------------------------------------------------------------------------

enum ItemCondition {
  NEW_SEALED
  NEW_OPENED
  USED_COMPLETE
  USED_INCOMPLETE
  DAMAGED
  UNKNOWN
}

/// A marketplace or retailer we pull prices from.
model Source {
  id       String  @id @default(cuid())
  /// Stable machine key: "ebay", "amiami", "hlj", "mandarake".
  key      String  @unique
  name     String
  homepage String?
  /// Whether the ingestion job should currently run for this source.
  enabled  Boolean @default(true)

  listings Listing[]
  sales    Sale[]
  runs     IngestRun[]
}

/// An item currently (or recently) offered for sale.
model Listing {
  id       String  @id @default(cuid())
  sourceId String
  source   Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  figureId String?
  figure   Figure? @relation(fields: [figureId], references: [id], onDelete: SetNull)

  /// The source's own ID for this listing — used to upsert instead of duplicating.
  externalId String
  title      String
  url        String
  imageUrl   String?
  condition  ItemCondition @default(UNKNOWN)

  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @db.VarChar(3)
  /// `amount` converted to USD using fxRate at the time we saw it.
  amountUsd   Decimal  @db.Decimal(12, 2)
  fxRate      Decimal  @db.Decimal(18, 8)
  shippingUsd Decimal? @db.Decimal(12, 2)

  isActive  Boolean  @default(true)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  /// Confidence that this listing really is the linked figure, 0..1.
  /// Anything below MATCH_REVIEW_THRESHOLD is excluded from price aggregation.
  matchScore Float?

  @@unique([sourceId, externalId])
  @@index([figureId, isActive])
  @@index([lastSeen])
}

/// A completed transaction. This is what actually drives market value.
///
/// Every row comes from a marketplace API. There is deliberately no path for a
/// visitor to add one: a price index that anyone can write to is a price index
/// anyone can move, and screening that reliably is a bigger problem than it
/// first looks. Corrections come through Submission instead, where a person
/// reads them before anything published changes.
model Sale {
  id       String @id @default(cuid())
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  figureId String
  figure   Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  externalId String?
  title      String?
  url        String?
  condition  ItemCondition @default(UNKNOWN)

  amount    Decimal @db.Decimal(12, 2)
  currency  String  @db.VarChar(3)
  amountUsd Decimal @db.Decimal(12, 2)
  fxRate    Decimal @db.Decimal(18, 8)

  soldAt DateTime

  createdAt DateTime @default(now())

  @@unique([sourceId, externalId])
  @@index([figureId, soldAt])
  @@index([soldAt])
  // Aggregation reads by (figure, condition, date) — this covers it.
  @@index([figureId, condition, soldAt])
}

/// One pre-aggregated row per figure/condition/day. The price chart reads only
/// this table, so it stays fast no matter how many raw sales we accumulate.
model PriceSnapshot {
  id        String        @id @default(cuid())
  figureId  String
  figure    Figure        @relation(fields: [figureId], references: [id], onDelete: Cascade)
  condition ItemCondition
  /// Midnight UTC of the day being summarized.
  date      DateTime      @db.Date

  /// What the figure sold for that day. Null when nothing sold — which, so far,
  /// is every day: there is no obtainable source of sold prices for this
  /// category, so these columns exist for the day one arrives rather than
  /// because one has. See docs/DATA_SOURCES.md.
  minUsd     Decimal? @db.Decimal(12, 2)
  medianUsd  Decimal? @db.Decimal(12, 2)
  avgUsd     Decimal? @db.Decimal(12, 2)
  maxUsd     Decimal? @db.Decimal(12, 2)
  /// How many sales went into this row. 1-2 means treat the point with suspicion.
  sampleSize Int?

  /// What sellers were asking that day, across every active listing we could
  /// see. This is the series the site can actually draw, and the reason a
  /// snapshot is now written for a figure that has asks but no sales.
  askMinUsd    Decimal? @db.Decimal(12, 2)
  askMedianUsd Decimal? @db.Decimal(12, 2)
  askMaxUsd    Decimal? @db.Decimal(12, 2)
  /// How many listings the ask figures came from. Shown next to them, because a
  /// median of two listings is not the same claim as a median of forty.
  askCount     Int?

  /// Lowest active asking price we saw that day, for the "buy it now" line.
  /// Superseded by askMinUsd, which is the same number named for what it is.
  lowestAskUsd Decimal? @db.Decimal(12, 2)

  @@unique([figureId, condition, date])
  @@index([figureId, date])
}

/// Audit log for ingestion jobs, so failures are visible instead of silent.
model IngestRun {
  id            String    @id @default(cuid())
  sourceId      String
  source        Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  /// "running" | "success" | "error"
  status        String    @default("running")
  itemsSeen     Int       @default(0)
  itemsUpserted Int       @default(0)
  error         String?

  @@index([sourceId, startedAt])
}

/// Record that we received and acted on an eBay account-deletion notification.
///
/// eBay requires production apps to handle these, and being able to show you
/// did is the whole point — so we keep proof of receipt.
///
/// Note what is NOT stored: the eBay username, user ID and eiasToken are all
/// personal data belonging to someone who just asked to be forgotten. Keeping
/// them to prove we deleted them would defeat the purpose. Instead we store a
/// one-way hash, which still lets us recognise a retry of the same
/// notification without retaining anything identifying.
model EbayAccountDeletion {
  id             String @id @default(cuid())
  /// eBay's ID for the notification. Unique so retries are idempotent.
  notificationId String @unique
  /// SHA-256 of the eBay user ID. Not reversible to the user.
  userRefHash    String

  eventDate     DateTime?
  receivedAt    DateTime  @default(now())
  /// Rows we erased in response. Expected to be 0 — we don't currently store
  /// anything keyed to an eBay user — but it's recorded rather than assumed.
  recordsErased Int       @default(0)

  @@index([userRefHash])
  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// Submissions — the one way the public can tell us something
// ---------------------------------------------------------------------------

enum SubmissionKind {
  /// General thoughts on the site.
  FEEDBACK
  /// Something is broken, or a page shows the wrong information.
  BUG
  /// A figure that ought to be in the catalogue and isn't.
  FIGURE
  /// A correction, or an image, for a figure already in the catalogue.
  EDIT
  /// A completed sale someone made or saw, awaiting review.
  SALE
}

enum SubmissionStatus {
  OPEN
  RESOLVED
  DECLINED
}

/// Something a visitor sent us: feedback, a bug, or a figure to add.
///
/// Nothing here changes the site by itself. A submission is a message that a
/// person reads and acts on, which is what makes it safe to accept from anyone
/// — including people who aren't signed in. Somebody blocked by a broken
/// sign-in still needs a way to say so, and requiring an account to report that
/// account creation is broken would be a poor joke.
model Submission {
  id     String           @id @default(cuid())
  kind   SubmissionKind
  status SubmissionStatus @default(OPEN)

  /// What they wrote, in their own words. Always required.
  details String

  /// Bug reports: the page it happened on.
  pageUrl String?

  /// Figure submissions. Kept as loose text on purpose — asking a visitor to
  /// pick our exact manufacturer spelling from a dropdown gets us worse data
  /// than letting them type what's on the box.
  figureName   String?
  manufacturer String?
  series       String?
  /// A link backing the request up: a product page, a shop, a listing.
  referenceUrl String?

  /// Edit suggestions: the figure the sender was looking at.
  figureId String?
  figure   Figure? @relation(fields: [figureId], references: [id], onDelete: SetNull)

  /// Field-by-field corrections to a figure already in the catalogue, as
  /// { field: proposedValue } holding only what the sender actually changed.
  ///
  /// JSON rather than a column each, because these mirror the figure's info
  /// box and that is not a fixed list — a column per field would mean a
  /// migration every time the page gains a row, and eight mostly-null columns
  /// on a table where the vast majority of rows are not corrections at all.
  proposedFields Json?

  /// Reported sales. Held here rather than in Sale until a moderator approves
  /// them: a Sale row is published price data, and the whole reason community
  /// reporting was removed once before is that it wrote straight into it.
  saleAmount    Decimal?       @db.Decimal(12, 2)
  saleCurrency  String?        @db.VarChar(3)
  saleDate      DateTime?
  saleCondition ItemCondition?
  /// A listing, invoice or screenshot backing it up. Optional, and the single
  /// most useful thing a reviewer can be given.
  saleUrl       String?
  /// What screening noticed, e.g. "6x MSRP". Not a verdict — a moderator reads
  /// it and decides.
  saleFlag      String?

  /// A link to an image the sender thinks belongs on the figure. A link, never
  /// an upload: catalogue images carry a credit and a licence note because
  /// permission was actually asked for, and accepting arbitrary uploads would
  /// put unlicensed photography on a public page under our name. A person
  /// checks the source before anything is published.
  imageUrl String?

  /// Set when the sender was signed in. Null for anonymous submissions.
  userId       String?
  user         User?   @relation("SubmissionsSent", fields: [userId], references: [id], onDelete: SetNull)
  /// Where to reply, for senders with no account. Optional — a bug report
  /// worth acting on is worth having even with no way to reply.
  contactEmail String?

  handledAt   DateTime?
  handledById String?
  handledBy   User?     @relation("SubmissionsHandled", fields: [handledById], references: [id], onDelete: SetNull)
  /// Note from whoever dealt with it, for the next person reading the queue.
  handlerNote String?

  createdAt DateTime @default(now())

  // The inbox reads open items oldest-first, so nothing sits forever.
  @@index([status, createdAt])
  @@index([kind, status])
  @@index([userId, createdAt])
  // The figure page's own suggestions, newest first.
  @@index([figureId, createdAt])
}

/// Fixed-window request counters.
///
/// Postgres-backed rather than in-memory because serverless functions don't
/// share memory — an in-memory counter would reset every cold start and be
/// enforced separately per instance, which is close to no limit at all.
///
/// One row per (key, window). Rows are disposable; the nightly job deletes old
/// ones. If traffic ever makes a database write per request the bottleneck,
/// this is the piece to move to Redis.
model RateLimit {
  id          String   @id @default(cuid())
  /// Bucket identity — e.g. "search:203.0.113.4".
  key         String
  /// Start of the window this count belongs to.
  windowStart DateTime
  count       Int      @default(0)

  @@unique([key, windowStart])
  @@index([windowStart])
}

/// Daily USD conversion rates, so historical prices stay reproducible.
model FxRate {
  id        String   @id @default(cuid())
  currency  String   @db.VarChar(3)
  date      DateTime @db.Date
  /// Multiply an amount in `currency` by this to get USD.
  rateToUsd Decimal  @db.Decimal(18, 8)

  @@unique([currency, date])
}

/// A whole month's average rate, for converting a price that was set in the
/// past — chiefly MSRP.
///
/// Deliberately not rows in `FxRate`. That table is keyed by exact date and
/// read as "the rate today"; a row dated the 1st of a month would be picked up
/// as today's rate every 1st, which is a wrong price once a month with nothing
/// to show for it in the logs.
///
/// Monthly rather than daily because the prices this converts are only known to
/// the month. The catalogue's release dates carry a day of 15 as a placeholder
/// — see scripts/import-gsc.ts — so a single day's rate would imply a precision
/// the release date never had. Averaging the month is both honest about that
/// and steadier than whichever day the placeholder happens to name.
model FxMonthly {
  id       String   @id @default(cuid())
  currency String   @db.VarChar(3)
  /// First day of the month, in UTC. The month is the unit; the day is storage.
  month    DateTime @db.Date
  /// Multiply an amount in `currency` by this to get USD as of that month.
  rateToUsd Decimal @db.Decimal(18, 8)
  /// How many daily quotes went into the average, so a thin month is visible.
  days     Int

  @@unique([currency, month])
}

// ---------------------------------------------------------------------------
// Users — schema is in place now so adding auth later needs no migration.
// Model shapes follow the Auth.js (NextAuth) Prisma adapter conventions.
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// Public profile handle, e.g. figureindex.com/u/ethan
  username      String?   @unique
  bio           String?
  role          UserRole  @default(USER)
  /// When false the user's collection is only visible to themselves.
  publicProfile Boolean   @default(false)
  createdAt     DateTime  @default(now())

  accounts           Account[]
  sessions           Session[]
  collectionItems    CollectionItem[]
  wishlistItems      WishlistItem[]
  priceAlerts        PriceAlert[]
  addedImages        FigureImage[]
  submissions        Submission[]      @relation("SubmissionsSent")
  handledSubmissions Submission[]      @relation("SubmissionsHandled")
  fieldLocks         FigureFieldLock[] @relation("FieldLocks")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CollectionItem {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  figureId String
  figure   Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  quantity      Int           @default(1)
  condition     ItemCondition @default(NEW_SEALED)
  /// What the user actually paid, for profit/loss against market value.
  paidAmount    Decimal?      @db.Decimal(12, 2)
  paidCurrency  String?       @db.VarChar(3)
  /// `paidAmount` converted at the rate on the day it was entered. Stored so
  /// portfolio totals can sum a mixed-currency collection without re-converting
  /// (and silently re-valuing) every past purchase on each page load.
  paidAmountUsd Decimal?      @db.Decimal(12, 2)
  purchasedAt   DateTime?
  notes         String?

  createdAt DateTime @default(now())

  @@unique([userId, figureId, condition])
  @@index([userId])
}

model WishlistItem {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  figureId String
  figure   Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)
  /// 1 = someday, 5 = grail.
  priority Int    @default(3)

  createdAt DateTime @default(now())

  @@unique([userId, figureId])
  @@index([userId])
}

model PriceAlert {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  figureId String
  figure   Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  /// Fire when a listing's USD price drops to or below this.
  targetUsd Decimal       @db.Decimal(12, 2)
  condition ItemCondition @default(NEW_SEALED)
  active    Boolean       @default(true)
  lastFired DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, figureId, condition])
  @@index([active])
}

enum CandidateStatus {
  /// Waiting for a person to look at it.
  OPEN
  /// Turned into a catalogue entry.
  ACCEPTED
  /// Looked at and rejected — a bundle, a bootleg, a number that meant
  /// something else. Kept rather than deleted so discovery does not keep
  /// proposing it every night.
  DISMISSED
}

/// A product the catalogue appears to be missing, inferred from listings.
///
/// The Good Smile archive we imported from stopped publishing in February 2024,
/// so everything released since is absent — while the eBay poll keeps pulling in
/// listings for those very products and finding nothing to attach them to. This
/// is that pile read the other way round: not "which figure is this listing?"
/// but "which figure does this catalogue not have?".
///
/// A candidate is never a figure. It is a note saying several sellers agree a
/// product exists, with the titles they wrote, for a person to check. Writing a
/// catalogue entry straight from marketplace text would put seller shorthand
/// into the field a price guide is judged on.
model FigureCandidate {
  id String @id @default(cuid())

  /// "NENDOROID:2509" for a release number, "SOLARIS:8842119" for a retailer's
  /// product. Unique, so a nightly re-run updates the row instead of stacking
  /// duplicates.
  key    String @unique

  /// Where the candidate came from, because the evidence differs by source and
  /// so does how much of it is needed. Several eBay sellers naming the same
  /// number is corroboration; a shop listing a product for sale is a different
  /// and stronger kind of claim.
  source String @default("EBAY_LISTINGS")

  /// The line and number on the box, when the source gives one. Null for a
  /// retailer's product that carries no release number — most figures outside
  /// the Nendoroid and figma lines do not have one, and those are exactly the
  /// manufacturers the catalogue is thinnest on.
  line   String?
  number String?

  /// The page this came from, for a moderator to check before accepting.
  sourceUrl String?

  /// The manufacturer as the source names it. A retailer knows who made what it
  /// sells, which is worth carrying even though it still needs confirming.
  vendor String?

  /// The source's own content classification, carried to the figure created
  /// from this candidate. See lib/ingest/nsfw.ts.
  nsfw       Boolean @default(false)
  nsfwSource String?

  /// How many distinct listings named this number. Corroboration is the whole
  /// basis for believing the product exists: one seller is a typo, several
  /// independently typing the same number is not.
  listingCount Int @default(0)

  /// A few of those titles verbatim, so a moderator can see what the sellers
  /// actually said rather than a summary of it.
  sampleTitles String[]

  status CandidateStatus @default(OPEN)

  /// Set when accepted, linking the candidate to the entry it became — so the
  /// same number is never proposed twice.
  figureId String?
  figure   Figure? @relation(fields: [figureId], references: [id], onDelete: SetNull)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  reviewedAt  DateTime?

  @@index([status, listingCount])
}
